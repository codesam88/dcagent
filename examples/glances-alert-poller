#!/usr/bin/env python3
"""
glances-alert-poller — poll the glances REST API and forward WARNING/CRITICAL
alerts to stdout.

Requires glances running in *web server* mode (not XML-RPC mode):
  glances -w                  # web server on port 61208 (REST API + WebUI)
  glances -w --disable-webui  # REST API only, no WebUI

Note: 'glances -s' runs the XML-RPC server (port 61209) which does NOT expose
the REST API used by this script.

Then pipe this script's output to dcagent:
  glances-alert-poller >> /run/dcagent.pipe

Alerts fire when a metric first crosses WARNING or CRITICAL. A recovery message
is sent when it drops back below WARNING.

Configuration (environment variables or /etc/dcagent/glances-poller.conf):

  GLANCES_URL        Base URL of the glances REST API.
                     Default: http://localhost:61208
  POLL_INTERVAL      Seconds between polls.
                     Default: 30
  FS_WARNING         Filesystem usage % to trigger a warning.
                     Default: 80
  FS_CRITICAL        Filesystem usage % to trigger a critical alert.
                     Default: 90
  MEM_WARNING        Memory usage % to trigger a warning.
                     Default: 80
  MEM_CRITICAL       Memory usage % to trigger a critical alert.
                     Default: 90
  LOAD_WARNING       Load average (1 min, per CPU) to trigger a warning.
                     Default: 0.7
  LOAD_CRITICAL      Load average (1 min, per CPU) to trigger a critical alert.
                     Default: 1.0
"""

import json
import logging
import os
import sys
import time
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.request import urlopen

log = logging.getLogger(__name__)

CONF_PATH = Path("/etc/dcagent/glances-poller.conf")
DEFAULT_URL = "http://localhost:61208"
DEFAULT_INTERVAL = 30


def load_conf() -> dict:
    conf = {}
    if CONF_PATH.exists():
        for line in CONF_PATH.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, val = line.partition("=")
            conf[key.strip()] = val.strip()
    return conf


def api_get(base_url: str, path: str, *, _warned: list = [False]) -> object:
    url = f"{base_url}{path}"
    try:
        with urlopen(url, timeout=5) as resp:
            if _warned[0]:
                log.info("Reconnected to glances at %s", base_url)
                _warned[0] = False
            return json.loads(resp.read())
    except HTTPError as exc:
        if not _warned[0]:
            log.warning(
                "HTTP error from glances at %s: %s — is glances running with -w (web server)?",
                base_url,
                exc,
            )
            _warned[0] = True
    except URLError as exc:
        if not _warned[0]:
            log.warning("Could not reach glances at %s: %s — will keep retrying", base_url, exc)
            _warned[0] = True
    return None


def check_level(value: float, warning: float, critical: float) -> str:
    """Return 'CRITICAL', 'WARNING', or '' based on thresholds."""
    if value >= critical:
        return "CRITICAL"
    if value >= warning:
        return "WARNING"
    return ""


def emit(alerts: dict, key: str, level: str, message: str) -> None:
    """Print message and update alert state, suppressing duplicates and sending recovery."""
    prev = alerts.get(key, "")
    if level == prev:
        return
    alerts[key] = level
    if level:
        icon = "🔴" if level == "CRITICAL" else "⚠️"
        print(f"{icon} {level}: {message}", flush=True)
    elif prev:
        print(f"✅ RECOVERED: {message}", flush=True)


def poll(base_url: str, conf: dict, alerts: dict) -> None:
    fs_warn = float(conf.get("FS_WARNING", 80))
    fs_crit = float(conf.get("FS_CRITICAL", 90))
    mem_warn = float(conf.get("MEM_WARNING", 80))
    mem_crit = float(conf.get("MEM_CRITICAL", 90))
    load_warn = float(conf.get("LOAD_WARNING", 0.7))
    load_crit = float(conf.get("LOAD_CRITICAL", 1.0))

    # Filesystem
    fs_data = api_get(base_url, "/api/3/fs")
    if fs_data is not None:
        for entry in fs_data:
            mount = entry.get("mnt_point", "?")
            percent = entry.get("percent", 0)
            level = check_level(percent, fs_warn, fs_crit)
            emit(alerts, f"fs:{mount}", level, f"disk {mount} usage at {percent:.1f}%")

    # Memory
    mem_data = api_get(base_url, "/api/3/mem")
    if mem_data is not None:
        percent = mem_data.get("percent", 0)
        level = check_level(percent, mem_warn, mem_crit)
        emit(alerts, "mem", level, f"memory usage at {percent:.1f}%")

    # Load (per-CPU normalised)
    load_data = api_get(base_url, "/api/3/load")
    cpu_data = api_get(base_url, "/api/3/cpu")
    if load_data is not None:
        cpus = (cpu_data or {}).get("cpucore", 1) or 1
        load1 = load_data.get("min1", 0) / cpus
        level = check_level(load1, load_warn, load_crit)
        emit(alerts, "load", level, f"load average {load_data.get('min1', 0):.2f} ({load1:.2f} per CPU)")


def main() -> None:
    logging.basicConfig(format="%(levelname)s: %(message)s")

    conf = load_conf()
    # Environment variables override config file
    for key in (
        "GLANCES_URL",
        "POLL_INTERVAL",
        "FS_WARNING",
        "FS_CRITICAL",
        "MEM_WARNING",
        "MEM_CRITICAL",
        "LOAD_WARNING",
        "LOAD_CRITICAL",
    ):
        if key in os.environ:
            conf[key] = os.environ[key]

    base_url = conf.get("GLANCES_URL", DEFAULT_URL)
    interval = int(conf.get("POLL_INTERVAL", DEFAULT_INTERVAL))

    alerts: dict[str, str] = {}

    while True:
        poll(base_url, conf, alerts)
        time.sleep(interval)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
