#!/usr/bin/env python3
"""
temp-status — report current sensor temperatures to dcagent status.
Sends: status 20_temp <chip>:<temp>°C [<chip>:<temp>°C ...]
Requires lm-sensors ('sensors' command).

Pipe the output to dcagent:
  temp-status >> /run/dcagent/dcagent.pipe

Configuration (environment variables or /etc/dcagent/temp-status.conf, as KEY=VALUE):

  REPORT_CHIPS        Space-separated list of chip name prefixes to include.
                      Default: all chips reported by sensors.

  IGNORE_CHIPS        Space-separated list of chip name prefixes to skip
                      (e.g. "acpitz iwlwifi"). Default: none ignored.

Usage:
  Run from cron or a systemd timer, e.g. every 5 minutes:
    */5 * * * * root /usr/local/lib/dcagent/examples/status/temp-status >> /run/dcagent/dcagent.pipe
"""

import json
import logging
import os
import shutil
import subprocess
import sys
from pathlib import Path

log = logging.getLogger(__name__)

CONF_PATH = Path("/etc/dcagent/temp-status.conf")


def load_conf() -> dict:
    conf = {}
    if CONF_PATH.exists():
        for line in CONF_PATH.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, val = line.partition("=")
            conf[key.strip()] = val.strip()
    return conf


def read_sensors() -> dict:
    if not shutil.which("sensors"):
        log.error("'sensors' not found — install lm-sensors")
        sys.exit(1)
    result = subprocess.run(["sensors", "-j"], capture_output=True, text=True, check=True)
    return json.loads(result.stdout)


def collect_temps(data: dict, report_prefixes: list[str], ignore_prefixes: list[str]) -> list[str]:
    parts = []
    for chip, sensors in data.items():
        if not isinstance(sensors, dict):
            continue
        if ignore_prefixes and any(chip.startswith(p) for p in ignore_prefixes):
            continue
        if report_prefixes and not any(chip.startswith(p) for p in report_prefixes):
            continue
        for label, vals in sensors.items():
            if not isinstance(vals, dict):
                continue
            for key, current in vals.items():
                if not key.endswith("_input") or not isinstance(current, (int, float)):
                    continue
                # Use a short label: chip-family + sensor label
                chip_short = chip.split("-")[0]
                parts.append(f"{chip_short}/{label}:{current:.0f}°C")
    return parts


def main() -> None:
    logging.basicConfig(format="%(levelname)s: %(message)s")

    conf = load_conf()

    report_raw = os.environ.get("REPORT_CHIPS") or conf.get("REPORT_CHIPS") or ""
    report_prefixes = report_raw.split()

    ignore_raw = os.environ.get("IGNORE_CHIPS") or conf.get("IGNORE_CHIPS") or ""
    ignore_prefixes = ignore_raw.split()

    data = read_sensors()
    parts = collect_temps(data, report_prefixes, ignore_prefixes)

    if parts:
        print(f"status 20_temp {' '.join(parts)}")


if __name__ == "__main__":
    main()
