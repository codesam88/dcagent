#!/usr/bin/env bash
# Report failed systemd services to stdout.
#
# Usage:
#   systemd-failed-alert                 # check all units
#   systemd-failed-alert >> /run/dcagent/dcagent.pipe
#
# Configuration (environment variables or $DCAGENT_CONFIG_PATH/conf.d/systemd-failed-alert.conf):
#
#   WATCH_SERVICES   Space-separated list of service names to watch.
#                    If set, only these services are checked.
#                    Default: (all failed units)

# Source global and per-script config
DCAGENT_CONFIG_PATH="${DCAGENT_CONFIG_PATH:-/etc/dcagent}"
DCAGENT_CONFIG_FILE="$DCAGENT_CONFIG_PATH/dcagent.conf"
# shellcheck source=/dev/null
[[ -f "$DCAGENT_CONFIG_FILE" ]] && source "$DCAGENT_CONFIG_FILE"

SCRIPT_NAME="${0##*/}"
ACTION_CONFIG_FILE="$DCAGENT_CONFIG_PATH/conf.d/$SCRIPT_NAME.conf"
# shellcheck source=/dev/null
[[ -f "$ACTION_CONFIG_FILE" ]] && source "$ACTION_CONFIG_FILE"

WATCH_SERVICES="${WATCH_SERVICES:-}"

if [[ -n "$WATCH_SERVICES" ]]; then
    for svc in $WATCH_SERVICES; do
        state=$(systemctl is-failed "$svc" 2>/dev/null)
        if [[ "$state" == "failed" ]]; then
            echo "alert 🔴 systemd service failed: $svc"
        fi
    done
else
    while read -r unit _load _active _sub _desc; do
        [[ -z "$unit" ]] && continue
        echo "alert 🔴 systemd service failed: $unit"
    done < <(systemctl --failed --no-legend --plain 2>/dev/null)
fi
