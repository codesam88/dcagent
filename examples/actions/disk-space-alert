#!/usr/bin/env bash
#
# disk-space-alert — report each partition exceeding a usage threshold to dcagent.
# Pipe the output to a socket listener via netcat:
#   disk-space-alert | nc -U /run/dcagent/dcagent.sock
#
# Configuration (environment variables or $DCAGENT_CONFIG_PATH/conf.d/disk-space-alert.conf):
#
#   ALERT_THRESHOLD   Usage percentage that triggers an alert (0-100).
#                     Default: 90
#
#   MONITOR_MOUNTS    Space-separated list of mount points to check.
#                     Default: all non-virtual mounted filesystems
#
# Usage:
#   Run from cron or a systemd timer, e.g. every 15 minutes:
#     */15 * * * * root /usr/local/lib/dcagent/examples/actions/disk-space-alert | nc -U $DCAGENT_LISTEN_SOCKET

set -euo pipefail

# ── Defaults ──────────────────────────────────────────────────────────────────

DCAGENT_CONFIG_PATH="${DCAGENT_CONFIG_PATH:-/etc/dcagent}"
ALERT_THRESHOLD="${ALERT_THRESHOLD:-90}"
MONITOR_MOUNTS="${MONITOR_MOUNTS:-}"

# ── Load global and per-script config ─────────────────────────────────────────

DCAGENT_CONFIG_FILE="$DCAGENT_CONFIG_PATH/dcagent.conf"
# shellcheck source=/dev/null
[[ -f "$DCAGENT_CONFIG_FILE" ]] && source "$DCAGENT_CONFIG_FILE"

SCRIPT_NAME="${0##*/}"
ACTION_CONFIG_FILE="$DCAGENT_CONFIG_PATH/conf.d/$SCRIPT_NAME.conf"
# shellcheck source=/dev/null
[[ -f "$ACTION_CONFIG_FILE" ]] && source "$ACTION_CONFIG_FILE"

# ── Check disk usage ──────────────────────────────────────────────────────────


if [[ -n "$MONITOR_MOUNTS" ]]; then
    df_output=$(df --output=pcent,target ${MONITOR_MOUNTS} 2>/dev/null | tail -n +2)
else
    df_output=$(df --output=pcent,target --exclude-type=tmpfs --exclude-type=devtmpfs \
        --exclude-type=squashfs 2>/dev/null | tail -n +2)
fi

while read -r pct mount; do
    pct="${pct%%%}"
    mount_cat="disk-usage-$mount"

    if (( pct >= ALERT_THRESHOLD )); then
        echo "alert $mount_cat ${pct}% full (threshold: ${ALERT_THRESHOLD}%)"
    else
        echo "alert $mount_cat"
    fi
done <<< "$df_output"
