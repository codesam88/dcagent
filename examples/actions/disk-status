#!/usr/bin/env bash
#
# disk-status — report the highest disk usage to dcagent status.
# Sends: status ${DISK_STATUS_KEY:-30_disk} <mount>:<pct>%   (worst partition only, e.g. "home:72%")
# Pipe the output to dcagent:
#   disk-status >> /run/dcagent/dcagent.pipe
#
# Configuration (environment variables or $DCAGENT_CONFIG_PATH/conf.d/disk-status.conf):
#
#   MONITOR_MOUNTS    Space-separated list of mount points to check.
#                     Default: all non-virtual mounted filesystems
#
# Usage:
#   Run from cron or a systemd timer, e.g. every 5 minutes:
#     */5 * * * * root /usr/local/lib/dcagent/examples/actions/disk-status >> /run/dcagent/dcagent.pipe

set -euo pipefail

# ── Defaults ──────────────────────────────────────────────────────────────────

DCAGENT_CONFIG_PATH="${DCAGENT_CONFIG_PATH:-/etc/dcagent}"
MONITOR_MOUNTS="${MONITOR_MOUNTS:-}"

# Source global and per-script config
DCAGENT_CONFIG_FILE="$DCAGENT_CONFIG_PATH/dcagent.conf"
# shellcheck source=/dev/null
[[ -f "$DCAGENT_CONFIG_FILE" ]] && source "$DCAGENT_CONFIG_FILE"

SCRIPT_NAME="${0##*/}"
ACTION_CONFIG_FILE="$DCAGENT_CONFIG_PATH/conf.d/$SCRIPT_NAME.conf"
# shellcheck source=/dev/null
[[ -f "$ACTION_CONFIG_FILE" ]] && source "$ACTION_CONFIG_FILE"

# ── Find worst partition ──────────────────────────────────────────────────────

if [[ -n "$MONITOR_MOUNTS" ]]; then
    df_output=$(df --output=pcent,target ${MONITOR_MOUNTS} 2>/dev/null | tail -n +2)
else
    df_output=$(df --output=pcent,target --exclude-type=tmpfs --exclude-type=devtmpfs \
        --exclude-type=squashfs 2>/dev/null | tail -n +2)
fi

worst_pct=0
worst_mount=""
while read -r pct mount; do
    pct="${pct%%%}"
    if (( pct > worst_pct )); then
        worst_pct="$pct"
        worst_mount="$mount"
    fi
done <<< "$df_output"

if [[ -n "$worst_mount" ]]; then
    status_key="${DISK_STATUS_KEY:-30_disk}"
    # Use basename for brevity; keep "/" as-is
    short="${worst_mount##*/}"
    [[ -z "$short" ]] && short="/"
    echo "status $status_key ${short}:${worst_pct}%"
fi
