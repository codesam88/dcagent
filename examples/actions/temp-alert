#!/usr/bin/env python3
"""
temp-alert — print a line to stdout for each sensor temperature exceeding a threshold.
Requires lm-sensors ('sensors' command).

Pipe the output to dcagent:
  temp-alert >> /run/dcagent/dcagent.pipe

Configuration (environment variables or $DCAGENT_CONFIG_PATH/conf.d/temp-alert.conf, as KEY=VALUE):

  ALERT_THRESHOLD_C   Temperature in °C that triggers an alert for all sensors.
                      Default: uses each sensor's own 'high'/'max' value,
                      falling back to 85°C if none is reported.

  IGNORE_CHIPS        Space-separated list of chip name prefixes to skip
                      (e.g. "acpitz iwlwifi"). Default: none ignored.

Usage:
  Run from cron or a systemd timer, e.g. every 5 minutes:
    */5 * * * * root /usr/local/lib/dcagent/examples/actions/temp-alert >> /run/dcagent/dcagent.pipe
"""

import json
import logging
import os
import shutil
import subprocess
import sys
from pathlib import Path

log = logging.getLogger(__name__)

DCAGENT_CONFIG_PATH = os.environ.get("DCAGENT_CONFIG_PATH", "/etc/dcagent")
DCAGENT_CONFIG_FILE = f"{DCAGENT_CONFIG_PATH}/dcagent.conf"
DEFAULT_FALLBACK_THRESHOLD = 85.0


def _load_action_conf(path: str) -> dict:
    conf = {}
    p = Path(path)
    if p.exists():
        for line in p.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            conf[k.strip()] = v.strip().strip('"')
    # Export to environment so other code can read DCAGENT_* variables
    os.environ.update(conf)
    return conf


def load_conf() -> dict:
    conf = {}
    # Load global config first, then per-script overrides.
    conf.update(_load_action_conf(DCAGENT_CONFIG_FILE))
    action_path = os.environ.get("DCAGENT_CONFIG_PATH", DCAGENT_CONFIG_PATH)
    conf.update(_load_action_conf(f"{action_path}/conf.d/temp-alert.conf"))
    return conf


def read_sensors() -> dict:
    if not shutil.which("sensors"):
        log.error("'sensors' not found — install lm-sensors")
        sys.exit(1)
    result = subprocess.run(["sensors", "-j"], capture_output=True, text=True, check=True)
    return json.loads(result.stdout)


def check_temps(data: dict, threshold_override: float | None, ignore_prefixes: list[str]) -> None:
    """Check temperatures and emit per-sensor alerts that can be cleared individually."""
    for chip, sensors in data.items():
        if not isinstance(sensors, dict):
            continue
        if any(chip.startswith(p) for p in ignore_prefixes):
            continue
        for label, vals in sensors.items():
            if not isinstance(vals, dict):
                continue
            for key, current in vals.items():
                if not key.endswith("_input"):
                    continue
                prefix = key[:-6]
                if threshold_override is not None:
                    threshold = threshold_override
                else:
                    threshold = (
                        vals.get(f"{prefix}_max")
                        or vals.get(f"{prefix}_high")
                        or vals.get(f"{prefix}_crit")
                        or DEFAULT_FALLBACK_THRESHOLD
                    )
                # Create a unique category per sensor: temperature-<chip>-<label>
                # Sanitize label/chip for use as category (replace spaces/special chars with -)
                chip_safe = chip.replace(" ", "-").lower()
                label_safe = label.replace(" ", "-").lower()
                category = f"temperature-{chip_safe}-{label_safe}"

                if current >= threshold:
                    print(f"alert {category} {current:.1f}C >= {threshold:.1f}C")
                else:
                    print(f"alert {category}")


def main() -> None:
    logging.basicConfig(format="%(levelname)s: %(message)s")

    conf = load_conf()

    threshold_raw = os.environ.get("ALERT_THRESHOLD_C") or conf.get("ALERT_THRESHOLD_C")
    threshold_override = float(threshold_raw) if threshold_raw else None

    ignore_raw = os.environ.get("IGNORE_CHIPS") or conf.get("IGNORE_CHIPS") or ""
    ignore_prefixes = ignore_raw.split()

    data = read_sensors()
    check_temps(data, threshold_override, ignore_prefixes)


if __name__ == "__main__":
    main()
