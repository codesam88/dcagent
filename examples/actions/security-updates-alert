#!/usr/bin/env bash
#
# security-updates-alert — report pending security updates via apt.
# Sends an alert listing all security packages and a status summary.
#   alert security-updates N security update(s) available: pkg1, pkg2, ...
#   status ${SECURITY_UPDATES_ALERT_STATUS_KEY:-10_updates} N security update(s) pending   (or: up to date)
#
# Pipe the output to dcagent:
#   security-updates-alert >> /run/dcagent/dcagent.pipe
#
# NOTE: Uses the existing apt cache — run `apt-get update` beforehand
# (e.g. via a systemd timer or cron) to keep results current.
#
# Usage:
#   Run from cron or a systemd timer, e.g. every hour:
#     0 * * * * root apt-get -qq update && /usr/local/lib/dcagent/examples/actions/security-updates-alert >> /run/dcagent/dcagent.pipe

set -euo pipefail

# Source global and per-script config
DCAGENT_CONFIG_PATH="${DCAGENT_CONFIG_PATH:-/etc/dcagent}"
DCAGENT_CONFIG_FILE="$DCAGENT_CONFIG_PATH/dcagent.conf"
# shellcheck source=/dev/null
[[ -f "$DCAGENT_CONFIG_FILE" ]] && source "$DCAGENT_CONFIG_FILE"

SCRIPT_NAME="${0##*/}"
ACTION_CONFIG_FILE="$DCAGENT_CONFIG_PATH/conf.d/$SCRIPT_NAME.conf"
# shellcheck source=/dev/null
[[ -f "$ACTION_CONFIG_FILE" ]] && source "$ACTION_CONFIG_FILE"

# ── Discover pending security updates ────────────────────────────────────────

# apt-get -s simulates the upgrade without changing anything.
# Lines matching "^Inst ... security" identify packages from security repos.
mapfile -t pkgs < <(
    apt-get -s dist-upgrade 2>/dev/null \
        | grep "^Inst" \
        | grep -i "security" \
        | awk '{print $2}'
)

count="${#pkgs[@]}"

# ── Report ────────────────────────────────────────────────────────────────────

if (( count > 0 )); then
    pkg_list="${pkgs[*]}"
    echo "alert security-updates ${count} security update(s) available: ${pkg_list// /, }"
    status_key="${SECURITY_UPDATES_ALERT_STATUS_KEY:-10_updates}"
    echo "status $status_key need-patches"
else
    echo "alert security-updates"
    status_key="${SECURITY_UPDATES_ALERT_STATUS_KEY:-10_updates}"
    echo "status $status_key up-to-date"
fi
