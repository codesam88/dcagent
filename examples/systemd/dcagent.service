[Unit]
Description=dcagent monitoring bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dcagent
Environment=HOME=/var/lib/dcagent
EnvironmentFile=-/etc/dcagent/dcagent.conf
WorkingDirectory=/var/lib/dcagent
RuntimeDirectory=dcagent
ExecStart=/usr/local/bin/dcagent serve
ExecStartPost=/usr/local/bin/dcagent-run-actions
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
