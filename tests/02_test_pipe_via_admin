#!/usr/bin/env bash
#
# Test end-to-end interaction and message delivery by launching two bot
# instances to join and talk to each other.
#
# Two dcagent instances:
#   OWNER — owns the admin channel, receives the message
#   AGENT — joins OWNER's admin channel, sends a message via pipe
#
# Pass condition: OWNER's serve log contains the sent message text,
# confirming end-to-end delivery over the chatmail network.
#
# Usage:
#   make test-online

set -euo pipefail
cd "$(dirname "$0")/.."

DCAGENT="${DCAGENT:-uv run --quiet dcagent}"
CHATMAIL="${CHATMAIL:-https://nine.testrun.org/new}"
TIMEOUT="${TIMEOUT:-60}"

# ── Helpers ───────────────────────────────────────────────────────────────────

wait_for_log() {
    local file="$1" pattern="$2" timeout="$3"
    local elapsed=0
    until grep -q "$pattern" "$file" 2>/dev/null; do
        sleep 1
        elapsed=$(( elapsed + 1 ))
        if (( elapsed >= timeout )); then
            echo "TIMEOUT: '$pattern' not found in $file after ${timeout}s" >&2
            return 1
        fi
    done
}

wait_for_file() {
    local path="$1" timeout="$2"
    local elapsed=0
    until [[ -e "$path" ]]; do
        sleep 1
        elapsed=$(( elapsed + 1 ))
        if (( elapsed >= timeout )); then
            echo "TIMEOUT: $path did not appear after ${timeout}s" >&2
            return 1
        fi
    done
}

dump_logs() {
    echo "--- OWNER log at <$OWNER_LOG> ---" >&2
    cat "$OWNER_LOG" >&2
    echo "--- AGENT log at <$AGENT_LOG> ---" >&2
    cat "$AGENT_LOG" >&2
}

# ── Setup ─────────────────────────────────────────────────────────────────────

TEMPDIR=$(mktemp -d -t tmp.dca_XXXX)
echo "    Creating config and logs at $TEMPDIR/{owner/agent}"

mkdir -p $TEMPDIR/owner
mkdir -p $TEMPDIR/agent
OWNER_DIR=$TEMPDIR/owner
AGENT_DIR=$TEMPDIR/agent

OWNER="$DCAGENT --config-dir $OWNER_DIR"
AGENT="$DCAGENT --config-dir $AGENT_DIR"

AGENT_PIPE="$AGENT_DIR/cmd.pipe"
OWNER_LOG="$OWNER_DIR/serve.log"
AGENT_LOG="$AGENT_DIR/serve.log"
OWNER_PID=""
AGENT_PID=""

cleanup() {
    [[ -n "$OWNER_PID" ]] && kill "$OWNER_PID" 2>/dev/null || true
    [[ -n "$AGENT_PID" ]] && kill "$AGENT_PID" 2>/dev/null || true
}
trap cleanup EXIT

# ── Provision ─────────────────────────────────────────────────────────────────

echo "==> Provisioning accounts on $CHATMAIL ..."
$OWNER init "dcaccount:$CHATMAIL"
$OWNER config displayname "owner"

$AGENT init "DCACCOUNT:$CHATMAIL"
$AGENT config displayname "agent"

# Fetch invite before starting serve — can't open the same accounts dir twice.
echo "==> Getting OWNER admin invite ..."
INVITE=$($OWNER admin 2>/dev/null | grep '^https://' | head -1)
echo "    invite=${INVITE}"

# ── Start OWNER serve ─────────────────────────────────────────────────────────

echo "==> Starting OWNER serve ..."
$OWNER --logging debug serve >"$OWNER_LOG" 2>&1 &
OWNER_PID=$!
wait_for_log "$OWNER_LOG" "Listening at" "$TIMEOUT"

# ── AGENT joins admin channel ─────────────────────────────────────────────────

echo "==> AGENT joining admin channel ..."
CHAT_ID=$($AGENT admin "$INVITE" 2>/dev/null)
[[ "$CHAT_ID" =~ ^[0-9]+$ ]] || { echo "ERROR: could not parse chat_id from join output: '$CHAT_ID'" >&2; exit 1; }
echo "    chat_id=$CHAT_ID"

# ── Start AGENT serve ─────────────────────────────────────────────────────────

echo "==> Starting AGENT serve ..."
$AGENT serve --pipe "$AGENT_PIPE" >"$AGENT_LOG" 2>&1 &
AGENT_PID=$!
wait_for_log "$AGENT_LOG" "Listening at" "$TIMEOUT"
wait_for_file "$AGENT_PIPE" 10

# ── Send message and verify ───────────────────────────────────────────────────

MSG="hello from integration test $$"
echo "==> Sending: $MSG"
printf '{"cmd":"send","chat_id":%s,"text":"%s"}\n' "$CHAT_ID" "$MSG" > "$AGENT_PIPE"

echo "==> Waiting for OWNER to log the received message ..."
if ! wait_for_log "$OWNER_LOG" "$MSG" "$TIMEOUT"; then
    dump_logs
    exit 1
fi

echo "PASS"
cleanup
rm -rf "$TEMPDIR"
