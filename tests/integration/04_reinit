#!/usr/bin/env bash
#
# Verify that 'init' refuses to overwrite an existing account without --force,
# and that --force re-initializes the account with a new email and displayname.

set -euo pipefail
source "$(dirname "$0")/helpers.sh"

(
    flock -x 9

    echo "==> 04_reinit: init without --force should fail"

    output=$($AGENT init "DCACCOUNT:$CHATMAIL" 2>&1 || true)
    if echo "$output" | grep -q "\-\-force"; then
        echo "OK: got expected --force error"
    else
        fatal_abort "expected --force error, got: $output"
    fi


    echo "==> 04_reinit: recording current addr and displayname"

    old_addr=$($AGENT config addr 2>/dev/null | sed "s/addr='\(.*\)'/\1/")
    old_name=$($AGENT config displayname 2>/dev/null | sed "s/displayname='\(.*\)'/\1/")
    echo "  old addr=$old_addr displayname=$old_name"

    echo "==> 04_reinit: init --force should re-initialize the account"

    $AGENT init --force "DCACCOUNT:$CHATMAIL"
    $AGENT config displayname "agent-reinit"

    new_addr=$($AGENT config addr 2>/dev/null | sed "s/addr='\(.*\)'/\1/")
    new_name=$($AGENT config displayname 2>/dev/null | sed "s/displayname='\(.*\)'/\1/")
    echo "  new addr=$new_addr displayname=$new_name"

    if [[ "$new_addr" == "$old_addr" ]]; then
        fatal_abort "addr did not change after --force reinit (still $old_addr)"
    fi
    echo "OK: addr changed ($old_addr -> $new_addr)"

    if [[ "$new_name" != "agent-reinit" ]]; then
        fatal_abort "displayname is '$new_name', expected 'agent-reinit'"
    fi
    echo "OK: displayname is '$new_name'"

    # Restore displayname and re-stamp provisioning sentinel
    $AGENT config displayname "agent"
    rm -f "$AGENT_PROVISIONED"
    touch "$AGENT_PROVISIONED"

) 9>"$AGENT_LOCK"

echo "PASS [$0]"
