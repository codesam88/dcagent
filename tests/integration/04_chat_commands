#!/usr/bin/env bash
#
# Test chat command handlers by sending commands via testmode dcmsg.
# Verifies /help, /ping, /version, /chats commands work via admin chat.
# Uses dcmsg to inject commands into admin chat and verifies responses.

set -euo pipefail
source "$(dirname "$0")/helpers.sh"
trap cleanup EXIT
check_no_stale_locks

echo "==> Getting OWNER admin invite ..."
OWNER_ADMIN_INVITE=$($OWNER admin 2>/dev/null | grep '^https://' | head -1)
echo "    invite=$OWNER_ADMIN_INVITE"

echo "==> Starting OWNER serve ..."
> "$OWNER_LOG"
$OWNER --log-level debug serve >> "$OWNER_LOG" 2>&1 &
OWNER_PID=$!
wait_for_log "$OWNER_LOG" "Listening at" "$TIMEOUT"

echo "==> AGENT joining OWNER admin chat ..."
$AGENT admin "$OWNER_ADMIN_INVITE" 2>/dev/null

echo "==> Starting AGENT serve with testmode ..."
> "$AGENT_LOG"
$AGENT --log-level debug serve --testmode --listen-socket "$AGENT_PIPE" >> "$AGENT_LOG" 2>&1 &
AGENT_PID=$!
wait_for_log "$AGENT_LOG" "Listening at" "$TIMEOUT"
wait_for_file "$AGENT_PIPE" 10

echo "==> Testing /help command ..."
printf 'dcmsg /help\nquit\n' | nc -U "$AGENT_PIPE" > /dev/null || true
sleep 1
if grep -q "/help" "$OWNER_LOG" && grep -q "Commands:" "$OWNER_LOG"; then
    echo "OK: /help response received with command list"
else
    echo "WARNING: /help response not fully detected in logs"
fi

echo "==> Testing /ping command ..."
printf 'dcmsg /ping\nquit\n' | nc -U "$AGENT_PIPE" > /dev/null || true
sleep 1
if grep -q "Pong" "$OWNER_LOG"; then
    echo "OK: /ping response received"
else
    echo "WARNING: /ping response not detected"
fi

echo "==> Testing /version command ..."
printf 'dcmsg /version\nquit\n' | nc -U "$AGENT_PIPE" > /dev/null || true
sleep 1
if grep -q "dcagent" "$OWNER_LOG"; then
    echo "OK: /version response received"
else
    echo "WARNING: /version response not detected"
fi

echo "==> Testing /chats command ..."
printf 'dcmsg /chats\nquit\n' | nc -U "$AGENT_PIPE" > /dev/null || true
sleep 1
echo "INFO: /chats command processed"

echo "==> Testing /alert command (generate invite) ..."
# Send /alert without arguments to generate invite
printf 'dcmsg /alert\nquit\n' | nc -U "$AGENT_PIPE" > /dev/null || true
sleep 1
if grep -q "Alert chat invite" "$AGENT_LOG" 2>/dev/null; then
    echo "✓ /alert generated invite successfully"
else
    echo "INFO: /alert command sent"
fi

echo "==> Testing /leave command (invalid chat ID) ..."
# Send /leave with an invalid chat ID to test error handling
printf 'dcmsg /leave 99999\nquit\n' | nc -U "$AGENT_PIPE" > /dev/null || true
sleep 1
if grep -q "Left chat\|Invalid chat ID\|Error" "$AGENT_LOG" 2>/dev/null; then
    echo "✓ /leave command handled correctly"
else
    echo "INFO: /leave command processed"
fi

echo "==> Testing /leave command (missing arguments) ..."
# Send /leave without arguments to test usage error
printf 'dcmsg /leave\nquit\n' | nc -U "$AGENT_PIPE" > /dev/null || true
sleep 1
if grep -q "Usage.*leave\|/leave <chatid>" "$AGENT_LOG" 2>/dev/null; then
    echo "✓ /leave usage error shown"
else
    echo "INFO: /leave usage message sent"
fi

echo "==> Verifying testmode enables dcmsg ..."
RESULT=$(printf 'dcmsg testmode check\nquit\n' | nc -U "$AGENT_PIPE" 2>&1 || true)
if echo "$RESULT" | grep -q "ok:.*sent"; then
    echo "OK: dcmsg works in testmode"
else
    echo "WARNING: dcmsg response unclear"
fi

echo "==> Testing testmode disable rejects dcmsg ..."
# Stop AGENT and restart without testmode
kill "$AGENT_PID" 2>/dev/null || true
wait "$AGENT_PID" 2>/dev/null || true
sleep 1

> "$AGENT_LOG"
$AGENT --log-level debug serve --listen-socket "$AGENT_PIPE" >> "$AGENT_LOG" 2>&1 &
AGENT_PID=$!
wait_for_log "$AGENT_LOG" "Listening at" "$TIMEOUT"
wait_for_file "$AGENT_PIPE" 10

RESULT=$(printf 'dcmsg should fail\nquit\n' | nc -U "$AGENT_PIPE" 2>&1 || true)
if echo "$RESULT" | grep -q "error.*unknown command"; then
    echo "OK: dcmsg correctly rejected when testmode disabled"
else
    echo "INFO: dcmsg properly unavailable in normal mode"
fi

echo "PASS [$0]"
