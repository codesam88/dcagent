#!/usr/bin/env bash
#
# Test pipe 'status' command: ordering and updates verified via debug log.

set -euo pipefail
source "$(dirname "$0")/helpers.sh"
trap cleanup EXIT

echo "==> Starting AGENT serve (debug logging) ..."
> "$AGENT_LOG"
$AGENT --log-level debug serve --pipe "$AGENT_PIPE" >> "$AGENT_LOG" 2>&1 &
AGENT_PID=$!
wait_for_log "$AGENT_LOG" "Listening at" "$TIMEOUT"
wait_for_file "$AGENT_PIPE" 10

echo "==> Setting status load=high (single key)"
printf 'status load high\n' > "$AGENT_PIPE"
wait_for_log "$AGENT_LOG" "selfstatus='high'" "$TIMEOUT"
echo "OK: single key"

echo "==> Adding status disk=93% (should sort: disk before load)"
printf 'status disk 93%%\n' > "$AGENT_PIPE"
wait_for_log "$AGENT_LOG" "selfstatus='93% high'" "$TIMEOUT"
echo "OK: two keys ordered alphabetically"

echo "==> Updating status load=normal (disk order preserved)"
printf 'status load normal\n' > "$AGENT_PIPE"
wait_for_log "$AGENT_LOG" "selfstatus='93% normal'" "$TIMEOUT"
echo "OK: existing key updated"

echo "PASS [$0]"
