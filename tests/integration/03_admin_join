#!/usr/bin/env bash
#
# Test that a pipe message from AGENT is forwarded to OWNER's admin channel.
# AGENT takes OWNER's admin invite as an alert chat, so pipe messages land there.
# Requires accounts to be provisioned (00_provision).

set -euo pipefail
source "$(dirname "$0")/helpers.sh"
trap cleanup EXIT
check_no_stale_locks

echo "==> Getting OWNER admin invite ..."
INVITE=$($OWNER admin 2>/dev/null | grep '^https://' | head -1)
echo "    invite=$INVITE"

echo "==> Starting OWNER serve ..."
> "$OWNER_LOG"
$OWNER --log-level debug serve >> "$OWNER_LOG" 2>&1 &
OWNER_PID=$!
wait_for_log "$OWNER_LOG" "Listening at" "$TIMEOUT"

echo "==> AGENT taking admin invite on alert channel ..."
$AGENT alert "$INVITE" 2>/dev/null

echo "==> Starting AGENT serve ..."
> "$AGENT_LOG"
$AGENT serve --listen-socket "$AGENT_PIPE" >> "$AGENT_LOG" 2>&1 &
AGENT_PID=$!
wait_for_log "$AGENT_LOG" "Listening at" "$TIMEOUT"
wait_for_file "$AGENT_PIPE" 10

echo "==> Sending test message via socket ..."
TOKEN="pipe-admin-test-$$-$RANDOM"
printf 'alert test-admin %s\n' "$TOKEN" | nc -U "$AGENT_PIPE"

echo "==> Waiting for OWNER to receive the message in ADMIN group..."
wait_for_log "$OWNER_LOG" "$TOKEN" "$TIMEOUT"

echo "PASS [$0]"
